# Vow Backend Production Environment Variables
NODE_ENV=production
PORT=3001

# Neon Serverless PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-your-neon-host.aws.neon.tech/neondb?sslmode=require

# Strong random secret (generate via: openssl rand -hex 32)
JWT_SECRET=replace_with_64_char_random_hex_secret

# UploadThing CDN token (for profile, chat, milestone & verification photos)
UPLOADTHING_TOKEN=your_uploadthing_token
